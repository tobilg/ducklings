diff --git a/CMakeLists.txt b/CMakeLists.txt
index 93c0fcf..c1eb71f 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -32,6 +32,9 @@ option(SPATIAL_USE_NETWORK "Enable network functionality" ON)
 # Enable GEOS support
 option(SPATIAL_USE_GEOS "Enable GEOS support" ON)
 
+# Parquet/httpfs queries do not need GDAL format readers.
+option(SPATIAL_USE_GDAL "Enable GDAL format readers" ON)
+
 add_subdirectory(src/spatial)
 add_subdirectory(src/sgl)
 include_directories(src)
@@ -52,13 +55,19 @@ set(ZLIB_USE_STATIC_LIBS ON)
 set(OPENSSL_USE_STATIC_LIBS ON)
 find_package(ZLIB REQUIRED)
 find_package(PROJ CONFIG REQUIRED)
-find_package(GDAL CONFIG REQUIRED)
+if(SPATIAL_USE_GDAL)
+  find_package(GDAL CONFIG REQUIRED)
+  add_definitions(-DSPATIAL_USE_GDAL=1)
+endif()
 find_package(EXPAT REQUIRED)
 find_package(unofficial-sqlite3 CONFIG REQUIRED)
 
 # Important: The link order matters, its the reverse order of dependency
-set(EXTENSION_DEPENDENCIES GDAL::GDAL PROJ::proj EXPAT::EXPAT
+set(EXTENSION_DEPENDENCIES PROJ::proj EXPAT::EXPAT
                            unofficial::sqlite3::sqlite3 ZLIB::ZLIB)
+if(SPATIAL_USE_GDAL)
+  list(PREPEND EXTENSION_DEPENDENCIES GDAL::GDAL)
+endif()
 
 if(SPATIAL_USE_GEOS)
   message(STATUS "Building with GEOS functionality")
diff --git a/src/spatial/modules/CMakeLists.txt b/src/spatial/modules/CMakeLists.txt
index 88337b9..f8e5aae 100644
--- a/src/spatial/modules/CMakeLists.txt
+++ b/src/spatial/modules/CMakeLists.txt
@@ -1,6 +1,8 @@
 add_subdirectory(main)
 add_subdirectory(proj)
-add_subdirectory(gdal)
+if(SPATIAL_USE_GDAL)
+  add_subdirectory(gdal)
+endif()
 if(SPATIAL_USE_GEOS)
   add_subdirectory(geos)
 endif()
diff --git a/src/spatial/spatial_extension.cpp b/src/spatial/spatial_extension.cpp
index c6a9232..3c6f1d2 100644
--- a/src/spatial/spatial_extension.cpp
+++ b/src/spatial/spatial_extension.cpp
@@ -4,7 +4,9 @@
 #include "duckdb.hpp"
 #include "index/rtree/rtree.hpp"
 #include "spatial/index/rtree/rtree_module.hpp"
+#if SPATIAL_USE_GDAL
 #include "spatial/modules/gdal/gdal_module.hpp"
+#endif
 #if SPATIAL_USE_GEOS
 #include "spatial/modules/geos/geos_module.hpp"
 #endif
@@ -37,7 +39,9 @@ static void LoadInternal(ExtensionLoader &loader) {
 	SpatialJoinOptimizer::Register(loader);
 
 	RegisterProjModule(loader);
+#if SPATIAL_USE_GDAL
 	RegisterGDALModule(loader);
