# Cloudflare — API token with Workers, R2, and DNS edit on the zone.
CLOUDFLARE_API_TOKEN=
# Cloudflare account id (dashboard -> Workers & Pages -> right sidebar).
CLOUDFLARE_ACCOUNT_ID=
# Optional: zone id, when the zone cannot be looked up by name.
CLOUDFLARE_ZONE_ID=
# Stage name alchemy uses (prod for the live deploy).
ALCHEMY_STAGE=dev
# `local` (default) keeps state in .alchemy/; `cloudflare` uses the shared
# state store (requires `alchemy provider cloudflare bootstrap` once).
ALCHEMY_STATE=local

# R2 S3-compatible credentials, used by `bun run seed` to upload the
# TPC-H Parquet dataset. The Worker itself reads R2 through its binding,
# so these are only needed for seeding.
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY_SECRET=
R2_ACCESS_KEY_ENDPOINT=

# Optional overrides.
# BUCKET_NAME=ducklings-alchemy-datasets
# DATASET_PREFIX=datasets/tpch/0_01
