{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ducklings-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-06",

  // Enable nodejs_compat for better compatibility
  "compatibility_flags": ["nodejs_compat"],

  // Workers limits:
  // - Free: 3MB code size, 128MB memory
  // - Paid: 10MB code size, 128MB memory
  // Note: the Workers WASM builds are ~9.7-9.8 MiB gzipped, so they require a paid plan.
}
