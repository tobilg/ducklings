{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ducklings-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-06",

  // Enable nodejs_compat for better compatibility
  "compatibility_flags": ["nodejs_compat"],

  // Workers limits:
  // - Free and Paid: 64 MiB uncompressed code size, 128 MB memory
  // - No compressed-size limit; CPU and other runtime limits differ by plan.
  // https://developers.cloudflare.com/workers/platform/limits/#worker-size
}
