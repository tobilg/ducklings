{
  "name": "@ducklings/workers-spatial",
  "version": "1.5.5",
  "description": "DuckDB Worker build with Parquet, httpfs, and spatial",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "default": "./dist/wasm/duckdb-workers.wasm"
    },
    "./wasm/*": "./dist/wasm/*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && pnpm postbuild",
    "postbuild": "mkdir -p dist/wasm && cp ../../dist/duckdb-workers-spatial.js dist/wasm/duckdb-workers.js && cp ../../dist/duckdb-workers-spatial.wasm dist/wasm/duckdb-workers.wasm && cp src/wasm.d.ts dist/wasm.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@uwdata/flechette": "^2.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260310.1",
    "@types/node": "^25.4.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "duckdb",
    "spatial",
    "wasm",
    "cloudflare-workers"
  ],
  "author": "tobilg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tobilg/ducklings",
    "directory": "packages/ducklings-workers-spatial"
  },
  "bugs": {
    "url": "https://github.com/tobilg/ducklings/issues"
  },
  "homepage": "https://github.com/tobilg/ducklings#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true
}
